import os
import subprocess

base_dir = os.path.dirname(os.path.abspath(__file__))
source_directory_path_1 = os.path.join(
    base_dir, 
    "src", 
    "shiftingbrowserfingerprints", 
    "__assets__", 
    "extensions", 
    "audio_ff_unsigned"
)

# Define your desired output folder
output_directory_path_1 = os.path.join(
    base_dir, 
    "src", 
    "shiftingbrowserfingerprints", 
    "__assets__", 
    "extensions", 
    "audio_ff_unsigned",
    "web-ext-artifacts"
)

clean_source_directory_path_1 = source_directory_path_1.replace("\\", "/")

def build_extension_1():
    # Define the absolute or relative path to your extension's root folder
    print("the source directory is: ", clean_source_directory_path_1)

    # Define the command arguments
    command = [
        "web-ext",
        "build",
        "--source-dir",
        clean_source_directory_path_1,
        "--artifacts-dir",
        output_directory_path_1,  # Directs the output to your custom path
        "--overwrite-dest",
        "--filename=audio_ff_unsigned_2.xpi",
    ]

    try:
        # Run the command
        result = subprocess.run(command, check=True, capture_output=True, text=True, shell=True)
        print("Build successful!")
        print(result.stdout)

    except subprocess.CalledProcessError as e:
        print("Build failed!")
        print(e.stderr)


source_directory_path_2 = os.path.join(
    base_dir, 
    "src", 
    "shiftingbrowserfingerprints", 
    "__assets__", 
    "extensions", 
    "battery_ff_unsigned"
)

# Define your desired output folder
output_directory_path_2 = os.path.join(
    base_dir, 
    "src", 
    "shiftingbrowserfingerprints", 
    "__assets__", 
    "extensions", 
    "battery_ff_unsigned",
    "web-ext-artifacts"
)

clean_source_directory_path_2 = source_directory_path_2.replace("\\", "/")

def build_extension_2():
    # Define the absolute or relative path to your extension's root folder
    print("the source directory is: ", clean_source_directory_path_2)

    # Define the command arguments
    command = [
        "web-ext",
        "build",
        "--source-dir",
        clean_source_directory_path_2,
        "--artifacts-dir",
        output_directory_path_2,  # Directs the output to your custom path
        "--overwrite-dest",
        "--filename=battery_ff_unsigned_2.xpi",
    ]

    try:
        # Run the command
        result = subprocess.run(command, check=True, capture_output=True, text=True, shell=True)
        print("Build successful!")
        print(result.stdout)

    except subprocess.CalledProcessError as e:
        print("Build failed!")
        print(e.stderr)


if __name__ == "__main__":
    build_extension_1()
    build_extension_2()