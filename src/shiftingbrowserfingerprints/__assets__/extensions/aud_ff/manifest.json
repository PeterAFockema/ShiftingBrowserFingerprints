{
	"manifest_version": 2,
	"name": "Audio Scrambler Unsigned",
	"version": "1.0",

	"description": "The audio element is used in browser fingerprinting, this is a local addon attempts to scramble the value.",

	"icons": {
		"48": "icons/border-48.png"
	},
	"permissions": [
		"<all_urls>",
		"webRequest",
		"webRequestBlocking"
  ],
    "background": {
        "scripts": [
            "background_for_audio.js"
        ],
        "persistent": true
    },
	"content_scripts": [
		{
			"matches": ["*://*/*"],
			"all_frames": true,
     		"run_at": "document_start",
			"js": ["scramble_audio_element.js"]
		}
	],

	"browser_specific_settings": {
		"gecko": {
			"id": "an_audio_scrambler@scrambled_unsigned.com",
			"data_collection_permissions": {
      			"required": ["none"],
      			"optional": []
    		}
		}
	}
}
