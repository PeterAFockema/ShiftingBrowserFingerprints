{
	"manifest_version": 2,
	"name": "WebGL Buffer Scrambler",
	"version": "1.0",

	"description": "For WebGL browser buffer fingerprinting, this attempts to scramble the value.",

	"icons": {
		"48": "icons/border-48.png"
	},

	"background": {
        "scripts": [
            "background_for_webgl.js"
        ],
        "persistent": true
    },

	"content_scripts": [
		{
			"matches": ["*://*/*"],
			"all_frames": true,
     		"run_at": "document_start",
			"js": ["scramble_buffer.js"]
		}
	],

	"browser_specific_settings": {
		"gecko": {
			"id": "a_webgl_buffer_scrambler@scrambled.com",
			"data_collection_permissions": {
      			"required": ["none"],
      			"optional": []
    		}
		}
	}
}
