{
	"manifest_version": 2,
	"name": "Screen AvailHeight Values Scrambler",
	"version": "2.0",

	"description": "For browser fingerprinting, this attempts to scramble the value for Screen.availHeight.",

	"icons": {
		"48": "icons/border-48.png"
	},

	"permissions": [
		"<all_urls>",
		"webRequest",
		"webRequestBlocking"
  ],
  
	"background": {
        "scripts": [
            "background_for_screen.js"
        ],
        "persistent": true
    },

	"content_scripts": [
		{
			"matches": ["*://*/*"],
			"all_frames": true,
     		"run_at": "document_start",
			"js": ["scramble_screen_avail_height_vals.js"]
		}
	],

	"browser_specific_settings": {
		"gecko": {
			"id": "a_screen_avail_height_scrambler@scrambled.com",
			"data_collection_permissions": {
      			"required": ["none"],
      			"optional": []
    		}
		}
	}
}
