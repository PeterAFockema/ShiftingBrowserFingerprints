{
	"manifest_version": 2,
	"name": "toDataURL Scrambler",
	"version": "1.0",

	"description": "The toDataURL element is used in browser fingerprinting, this attempts to scramble the value.",

	"icons": {
		"48": "icons/border-48.png"
	},

	"background": {
        "scripts": [
            "background_for_canvas.js"
        ],
        "persistent": true
    },
	
	"content_scripts": [
		{
			"matches": ["*://*/*"],
			"all_frames": true,
     		"run_at": "document_start",
			"js": ["scramble_to_data_url_element.js"]
		}
	],

	"browser_specific_settings": {
		"gecko": {
			"id": "a_to_data_URL_scrambler@scrambled.com",
			"data_collection_permissions": {
      			"required": ["none"],
      			"optional": []
    		}
		}
	}
}
